# Secrets - never bake these into an image, especially ones pushed to a
# registry. dev/dood/Dockerfile (and others) COPY the whole build context
# into /self, so anything listed here stays off disk in every image.
.env
.env.*
*.pem
*.key
*credentials*
*secret*

.git/

# Build outputs / deps of the dood console (rebuilt in the image)
**/node_modules
dev/dood/console/dist
